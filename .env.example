# Copy to .env (gitignored) and fill in. Server-side only; never expose to the browser.

# Notion internal integration (read content only). The "Language bar" database must be
# shared with the integration via ••• → Connections in Notion.
NOTION_TOKEN=
# Database ID (the 32-character id in the database URL) or the full URL.
NOTION_LESSONS_DATABASE_ID=

# Mistral (https://console.mistral.ai/api-keys). Without it lessons sync but the AI teacher is off.
MISTRAL_API_KEY=

# Optional
# Free-tier quotas differ per model; mistral-small/medium may have none. Check with GET /v1/models.
# MISTRAL_MODEL=ministral-14b-latest
# PORT=3001
# DATABASE_PATH=data/tutor.db
